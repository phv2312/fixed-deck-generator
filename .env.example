# Copy this file to `.env` and fill in the values. Never commit `.env`.
# The names are read by `decks/settings.py` (pydantic-settings).

# --- Azure OpenAI (AI layer) ---------------------------------------------------------------
# Azure portal > your Azure OpenAI resource > Keys and Endpoint.
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key>
# Use a version that supports structured outputs (and the Responses API if you use it).
AZURE_OPENAI_API_VERSION=<api-version>
# Azure AI Foundry > Deployments. This is the DEPLOYMENT name, not the model name.
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
# Optional. `responses` (default) or `chat_completions`.
# AZURE_OPENAI_API=responses
# Optional. none, minimal, low, medium, high or xhigh. Unset = the model default.
# A model without reasoning (for example gpt-4o) rejects this setting.
# AZURE_OPENAI_REASONING_EFFORT=none

# --- Backend (FastAPI) ---------------------------------------------------------------------
# Placeholder. Add variables here when the backend settings class exists.

# --- Agent runner --------------------------------------------------------------------------
# Optional. The newest chat items that one turn loads into the model context. Default 20.
# A lower number costs less. The model then forgets older turns.
# DECKS_HISTORY_LIMIT=20
