{% set dash %}
  {%- if e.dash %} stroke-dasharray="{{ page.line_dash }}"{% endif -%}
  {%- if e.arrow %} marker-end="url(#{{ marker_id }})"{% endif -%}
{% endset %}
{% set marker %}
  {%- if e.arrow -%}
  <defs>
    <marker id="{{ marker_id }}" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto">
      <path d="M0,0 L6,3 L0,6 z" fill="{{ color(e.color) }}"/>
    </marker>
  </defs>
  {%- endif -%}
{% endset %}
<svg class="e" data-element-id="{{ e.id|esc }}" width="{{ deck.width }}" height="{{ deck.height }}">
{{ marker }}
<line x1="{{ e.x1|g }}" y1="{{ e.y1|g }}" x2="{{ e.x2|g }}" y2="{{ e.y2|g }}" stroke="{{ color(e.color) }}" stroke-width="{{ e.width|g }}"{{ dash }}/>
</svg>
